PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Database Connection Strings
# Get these from Supabase Project Settings -> Database -> Connection String
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgboiler=true"
DIRECT_URL="postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Storage Credentials (Project Settings -> API)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_BUCKET="uploads"

JWT_SECRET="super-secret-key-change-in-production-12345!"
JWT_EXPIRES_IN="7d"
SERVER_URL="https://api.apandey.me"
