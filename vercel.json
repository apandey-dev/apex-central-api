{
  "version": 2,
  "env": {
    "DATABASE_URL": "file:./dev.db",
    "NODE_ENV": "production",
    "ALLOW_PUBLIC_REGISTRATION": "false"
  },
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["prisma/dev.db", "prisma/schema.prisma"]
      }
    }
  ],
  "routes": [
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
